@model OrderCreateViewModel
@{
    ViewData["Title"] = "New Order";
}

<h2 class="mb-3">New Order</h2>

<form asp-action="Create" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-2"></div>

    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="0">-- Select customer --</option>
        </select>
    </div>

    <div class="table-responsive">
    <table class="table bg-white">
        <thead>
            <tr>
                <th>Product</th>
                <th style="width: 140px;">Quantity</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="Lines[i].ProductId" asp-items="ViewBag.Products" class="form-select">
                            <option value="">-- Select product --</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="Lines[i].Quantity" type="number" min="1" class="form-control" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <p class="text-muted">Fill only the rows you need. Empty rows are ignored. The total and the new stock are calculated automatically when you save.</p>

    <button type="submit" class="btn btn-primary">Save Order</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
