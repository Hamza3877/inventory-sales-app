@model Order
@{
    ViewData["Title"] = "Invoice #" + Model.Id;
}

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
            <div>
                <h3 class="mb-0">Invoice #@Model.Id</h3>
                <div class="text-muted">@Model.OrderDate.ToString("dd MMM yyyy HH:mm")</div>
            </div>
            <div class="text-end">
                <strong>Bill to</strong><br />
                @Model.Customer.Name<br />
                @Model.Customer.Phone
            </div>
        </div>

        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Price (Rs)</th>
                    <th class="text-end">Total (Rs)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                        <td class="text-end">@item.LineTotal.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Grand Total</th>
                    <th class="text-end">Rs @Model.TotalAmount.ToString("N0")</th>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>
</div>

<div class="mt-3 d-print-none">
    <button type="button" class="btn btn-primary" onclick="window.print()">Print / Save as PDF</button>
    <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
</div>
