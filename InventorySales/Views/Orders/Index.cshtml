@model List<Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Orders</h2>
    <div>
        <a asp-action="ExportExcel" class="btn btn-outline-success">Export to Excel</a>
        <a asp-action="Create" class="btn btn-primary">+ New Order</a>
    </div>
</div>

<div class="table-responsive">
<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Order No</th>
            <th>Date</th>
            <th>Customer</th>
            <th class="text-end">Total (Rs)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.OrderDate.ToString("dd MMM yyyy HH:mm")</td>
                <td>@order.Customer.Name</td>
                <td class="text-end">@order.TotalAmount.ToString("N0")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">View Invoice</a>
                </td>
            </tr>
        }

        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted">No orders yet.</td></tr>
        }
    </tbody>
</table>
</div>