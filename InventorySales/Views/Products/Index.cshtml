@model PagedResult<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Products</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by product or category" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive">
<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th class="text-end">Price (Rs)</th>
            <th class="text-end">Stock</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Items)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category.Name</td>
                <td class="text-end">@product.Price.ToString("N0")</td>
                <td class="text-end">
                    @if (product.StockQuantity < 10)
                    {
                        <span class="badge text-bg-danger">@product.StockQuantity</span>
                    }
                    else
                    {
                        <span>@product.StockQuantity</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this product?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }

        @if (!Model.Items.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No products found.</td></tr>
        }
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
